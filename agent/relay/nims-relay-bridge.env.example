# URL of your local NIMS Server on the office LAN
NIMS_URL=https://191.20.110.191:3000

# Set true when NIMS Server uses Caddy self-signed LAN HTTPS
NIMS_ALLOW_INSECURE_TLS=true

# URL of your Cloudflare Worker Relay
RELAY_URL=https://nims-relay.jatdilok-on.workers.dev

# Must match the BRIDGE_SECRET variable/secret configured in Cloudflare Worker
BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Comma-separated list of NIMS_AGENT_TOKENs (one per remote site)
NIMS_AGENT_TOKENS=paste_site1_token_here,paste_site2_token_here

# How often (seconds) the Notebook polls Cloudflare Relay for ping reports
BRIDGE_POLL_SEC=15

# How often (seconds) to check NIMS Server for newly added devices
TARGETS_SYNC_SEC=120
