# =============================================================================
# NIMS - Network Infrastructure Management System
# Environment Configuration Example
# Copy to .env and replace placeholder secrets before production deployment.
# =============================================================================

# --- Database (MongoDB with Single-Node Replica Set rs0 for Prisma ORM) ---
DATABASE_URL=mongodb://127.0.0.1:27017/nims?replicaSet=rs0&directConnection=true
# MongoDB with authentication:
# DATABASE_URL=mongodb://nims_app:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:27017/nims?replicaSet=rs0&authSource=admin&directConnection=true

# --- Backend Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Security & Cryptography ---
# Generate 64-char hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_HEX_JWT_SECRET
# Separate 32-byte (64-hex) key used exclusively for AES-256-GCM Credential Encryption
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_64_HEX_AES_256_GCM_KEY
# Cookie security (set COOKIE_SECURE=true when serving over HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# --- File & Backup Storage (Local or Mounted NAS Path) ---
STORAGE_ROOT=./data/storage
BACKUP_ROOT=./data/backups
MAX_UPLOAD_SIZE_MB=100

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
INTERNAL_API_URL=http://127.0.0.1:4000/api
